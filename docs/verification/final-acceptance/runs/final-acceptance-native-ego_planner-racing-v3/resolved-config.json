{
  "algorithm": {
    "gradient": {
      "transition": "direct"
    },
    "name": "none"
  },
  "checkpoint": null,
  "config_version": 3,
  "env": {
    "execution": {
      "command": "trajectory",
      "controller": {
        "name": "crazyflow_attitude"
      },
      "dynamics": {
        "_target_": "drone_playground.models.crazyflow.CrazyflowModel",
        "drone": "cf21B_500",
        "forward": "first_principles"
      },
      "tracker": {
        "kp": 4.0,
        "kv": 3.0,
        "max_acceleration": 5.0,
        "name": "trajectory_tracking"
      }
    },
    "name": "racing",
    "observation": {
      "_target_": "drone_playground.environments.observations.TrackingObservation",
      "interval": 0.1,
      "n_samples": 10,
      "name": "state_reference"
    },
    "scene": {
      "_target_": "drone_playground.environments.scenes.LSYScene",
      "disturbances": true,
      "name": "lsy_level0"
    },
    "sensor": {
      "_target_": "drone_playground.environments.sensors.depth.DepthCamera",
      "far_m": 10.0,
      "height": 90,
      "history": 4,
      "horizontal_fov_deg": 85.2,
      "include_ground": true,
      "name": "d435_depth",
      "near_m": 0.1,
      "source_rate_hz": 30.0,
      "stride": 6,
      "width": 120
    },
    "task": {
      "duration": 30.0,
      "freq": 50,
      "name": "racing",
      "numerical_guard": false,
      "reference": "lsy_course",
      "reference_count": 256,
      "reference_generator": {
        "_target_": "drone_playground.methods.planners.reference.TrajectoryPlan",
        "amplitude": 1.0,
        "name": "lsy_course"
      }
    }
  },
  "evaluation": {
    "environment": "config",
    "episodes": 2,
    "output": null,
    "seed_start": null,
    "split": "heldout"
  },
  "method": {
    "container": "drone-playground-ros1",
    "implementation": "native_ego",
    "limits": {
      "max_acceleration_mps2": 3.0,
      "max_velocity_mps": 20.0,
      "planning_horizon_m": 7.5
    },
    "method": "ego",
    "name": "ego_planner",
    "output": "trajectory",
    "port": 55751,
    "trainable": false,
    "workers": 4
  },
  "migration": null,
  "mode": "eval",
  "network": {
    "name": "none"
  },
  "objective": {
    "_target_": "drone_playground.learning.objectives.TrackingObjective",
    "distance_scale": 2.0,
    "name": "tracking_exp",
    "scale": 1.0
  },
  "replay": {
    "directory": null
  },
  "run_id": "final-acceptance-native-ego_planner-racing-v3",
  "runtime": {
    "action_delay_ms": null,
    "action_delay_steps": 0,
    "backend": "host",
    "device": "cpu",
    "timing": "synchronous"
  },
  "source": "Native ego through ROS1; shared P5 geometry and dynamics",
  "training": {
    "development_episodes": 32,
    "max_wall_seconds": 3600,
    "num_envs": 1024,
    "num_evals": 9,
    "num_timesteps": 2097152,
    "policy_updates": 1024,
    "publish_live": false,
    "resume": null,
    "seed": 0,
    "warm_start": null
  },
  "visualization": {
    "mode": "rscope",
    "publish": true
  }
}
